# Ligação "pooled" do Neon (usada pela app). Termina normalmente em "-pooler" no host.
DATABASE_URL="<A_TUA_URL_POOLED>"
# Ligação direta do Neon (usada pelas migrações do Prisma).
DIRECT_URL="<A_TUA_URL_DIRETA>"
# PIN do administrador (mínimo 6 dígitos). Escolhe um teu; não o partilhes.
ADMIN_PIN="<O_TEU_PIN>"
