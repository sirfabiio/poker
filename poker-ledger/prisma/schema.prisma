// Valores monetários: SEMPRE inteiros em cêntimos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // ligação pooled (app)
  directUrl = env("DIRECT_URL") // ligação direta (migrações)
}

model Player {
  id                String    @id @default(cuid())
  name              String
  /// Nome normalizado (trim + minúsculas): garante unicidade case-insensitive.
  nameKey           String    @unique
  avatarColor       String
  active            Boolean   @default(true)
  ibanOrMbway       String?
  createdAt         DateTime  @default(now())
  createdByPlayerId String?
  /// Hash scrypt do PIN pessoal (com salt). NUNCA o PIN em texto. null = ainda não definiu (define no primeiro acesso).
  pinHash           String?
  /// Tentativas de login falhadas seguidas; ao chegar ao limite bloqueia até lockedUntil.
  failedPinAttempts Int       @default(0)
  lockedUntil       DateTime?

  createdBy      Player?         @relation("PlayerCreatedBy", fields: [createdByPlayerId], references: [id], onDelete: SetNull)
  createdPlayers Player[]        @relation("PlayerCreatedBy")
  sessions       Session[]       @relation("SessionCreatedBy")
  adjustedIn     Session[]       @relation("SessionAdjustmentPlayer")
  reconciled     Session[]       @relation("SessionReconciledBy")
  sessionPlayers SessionPlayer[]
  transfersOut   Transfer[]      @relation("TransferFrom")
  transfersIn    Transfer[]      @relation("TransferTo")
  activity       ActivityLog[]
  authSessions   AuthSession[]
  memberships    Membership[]
  groupsCreated  Group[]         @relation("GroupCreatedBy")

  @@index([createdByPlayerId])
}

/// Grupo de amigos: cada grupo só vê os seus jogadores, sessões, contas e histórico.
model Group {
  id                String   @id @default(cuid())
  name              String
  createdAt         DateTime @default(now())
  createdByPlayerId String?

  createdBy   Player?       @relation("GroupCreatedBy", fields: [createdByPlayerId], references: [id], onDelete: SetNull)
  memberships Membership[]
  sessions    Session[]
  settlements Settlement[]
  activity    ActivityLog[]

  @@index([createdByPlayerId])
}

enum GroupRole {
  ADMIN
  MEMBER
}

/// Pertença de um jogador a um grupo. Desativar = active false (some das listas do grupo, o histórico fica).
model Membership {
  id        String    @id @default(cuid())
  groupId   String
  playerId  String
  role      GroupRole @default(MEMBER)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  group  Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([groupId, playerId])
  @@index([playerId])
}

/// Sessão de login (persistente). O cookie leva um token aleatório; aqui só fica o hash SHA-256 desse token.
model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  playerId  String
  createdAt DateTime @default(now())
  expiresAt DateTime

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
}

model Session {
  id                String   @id @default(cuid())
  date              DateTime @db.Date
  notes             String?
  /// Buy-in por defeito desta sessão (cêntimos), usado no buy-in inicial e nos rebuys.
  defaultBuyIn      Int      @default(2000)
  createdAt         DateTime @default(now())
  createdByPlayerId String
  /// null = em aberto
  settlementId      String?
  /// Grupo dono da sessão (null só em dados anteriores aos grupos, até à migração)
  groupId           String?

  /// Diferença de contagem D = soma(cashOuts) − soma(buyIns) no momento do ajuste (null = sem ajuste)
  discrepancy          Int?
  adjustmentMethod     AdjustmentMethod?
  /// Só com SINGLE_PLAYER: quem absorve a diferença
  adjustmentPlayerId   String?
  reconciledAt         DateTime?
  reconciledByPlayerId String?

  /// Sobe 1 em cada escrita na sessão (mesma transação): as páginas abertas comparam-na para se atualizarem.
  version           Int     @default(0)
  lastActorPlayerId String?
  /// rebuy_added, rebuy_removed, cashout_set, player_added, player_removed, session_edited,
  /// adjustment_confirmed, adjustment_undone, session_settled (lib/live/bump.ts)
  lastChangeType    String?

  createdBy        Player          @relation("SessionCreatedBy", fields: [createdByPlayerId], references: [id])
  adjustmentPlayer Player?         @relation("SessionAdjustmentPlayer", fields: [adjustmentPlayerId], references: [id])
  reconciledBy     Player?         @relation("SessionReconciledBy", fields: [reconciledByPlayerId], references: [id])
  settlement       Settlement?     @relation(fields: [settlementId], references: [id])
  group            Group?          @relation(fields: [groupId], references: [id])
  players          SessionPlayer[]

  @@index([settlementId])
  @@index([groupId])
  @@index([createdByPlayerId])
  @@index([adjustmentPlayerId])
  @@index([reconciledByPlayerId])
  @@index([date])
}

enum AdjustmentMethod {
  EQUAL
  PROPORTIONAL
  SINGLE_PLAYER
}

model SessionPlayer {
  id         String @id @default(cuid())
  sessionId  String
  playerId   String
  /// cêntimos; null até ser preenchido
  cashOut    Int?
  /// Ajuste de contagem (cêntimos); 0 sem ajuste
  adjustment Int    @default(0)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player  Player  @relation(fields: [playerId], references: [id])
  buyIns  BuyIn[]

  @@unique([sessionId, playerId])
  @@index([playerId])
}

model BuyIn {
  id              String   @id @default(cuid())
  sessionPlayerId String
  /// cêntimos
  amount          Int
  createdAt       DateTime @default(now())

  sessionPlayer SessionPlayer @relation(fields: [sessionPlayerId], references: [id], onDelete: Cascade)

  @@index([sessionPlayerId])
}

model Settlement {
  id       String   @id @default(cuid())
  closedAt DateTime @default(now())
  label    String
  groupId  String?

  group     Group?     @relation(fields: [groupId], references: [id])
  sessions  Session[]
  transfers Transfer[]

  @@index([closedAt])
  @@index([groupId])
}

model Transfer {
  id           String    @id @default(cuid())
  settlementId String
  fromPlayerId String
  toPlayerId   String
  /// cêntimos
  amount       Int
  paid         Boolean   @default(false)
  paidAt       DateTime?

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  from       Player     @relation("TransferFrom", fields: [fromPlayerId], references: [id])
  to         Player     @relation("TransferTo", fields: [toPlayerId], references: [id])

  @@index([settlementId])
  @@index([fromPlayerId])
  @@index([toPlayerId])
}

model ActivityLog {
  id            String   @id @default(cuid())
  actorPlayerId String
  action        String
  entityType    String
  entityId      String
  summary       String
  createdAt     DateTime @default(now())
  /// null = evento pessoal (criar perfil, definir PIN), fora de qualquer grupo
  groupId       String?

  actor Player @relation(fields: [actorPlayerId], references: [id])
  group Group? @relation(fields: [groupId], references: [id])

  @@index([actorPlayerId])
  @@index([createdAt])
  @@index([groupId, createdAt])
}
